{
  "name": "fantasy-auction-team-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --project web",
    "test:server": "vitest run --project server",
    "test:all": "vitest run",
    "db:migrate": "node --env-file=.env --import tsx server/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx server/seed/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:ingest": "node --env-file=.env --import tsx server/ingestion/run.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
