# Copy this file to .env and adjust if needed. .env is gitignored; this
# template is committed. These are local dev defaults only, not real
# credentials — never put a real secret in this file.

POSTGRES_USER=fantasy_auction
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=fantasy_auction_dev

# Host port the Postgres container publishes on. Not 5432, because native
# PostgreSQL services on the dev machine may already hold 5432/5433 — in
# which case connections to 5432 reach those instead of the container.
POSTGRES_HOST_PORT=5434

# Used by the Express server (via the pg driver) to connect. Host/port must
# match POSTGRES_HOST_PORT above.
DATABASE_URL=postgresql://fantasy_auction:devpassword@localhost:5434/fantasy_auction_dev

# Port the Express API listens on. Vite's dev proxy reads this same value to
# forward /api, so both sides stay in sync from one source. Clear of Vite
# (5173) and the Postgres container (5434).
API_PORT=3001
